{
  "name": "@kodax-ai/repl",
  "version": "0.7.96-alpha.6",
  "description": "KodaX REPL - 完整的交互式终端体验",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session/public-api.d.ts",
      "import": "./dist/session/public-api.js"
    },
    "./cli-resume": {
      "types": "./dist/cli-resume.d.ts",
      "import": "./dist/cli-resume.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kodax-ai/agent": "*",
    "@kodax-ai/coding": "*",
    "@kodax-ai/llm": "*",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "ink": "^6.7.0",
    "jimp": "^1.6.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": ">=19.0.0",
    "string-width": "^7.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git",
    "directory": "packages/repl"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
