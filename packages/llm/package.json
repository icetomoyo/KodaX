{
  "name": "@kodax-ai/llm",
  "version": "0.7.97-beta.5",
  "description": "KodaX AI - 独立的 LLM 抽象层，可被其他项目复用",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -b && npm run copy:provider-caps",
    "copy:provider-caps": "node -e \"require('fs').mkdirSync('dist/providers',{recursive:true});require('fs').copyFileSync('src/providers/provider-capabilities.json','dist/providers/provider-capabilities.json')\"",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.15.0",
    "@anthropic-ai/sdk": "^0.104.2",
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@smithy/signature-v4": "5.6.12",
    "image-size": "2.0.2",
    "openai": "^6.32.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "4.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "openai": "^6.32.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git",
    "directory": "packages/llm"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
