# Dependencies
node_modules/

# Build output
dist/
native/**/target/
native/**/target-manylinux-2.28/
*.tsbuildinfo

# npm pack tarballs (produced by `node scripts/release.mjs --pack-only`).
# These are publish-ready artifacts for SDK consumer testing — never commit.
# See scripts/release.mjs:167-192 for the produce-and-consume flow.
*.tgz

# Prevent accidental commit of tsc emit alongside source files
# (e.g. running tsc without proper outDir configuration)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
.codex*/
# This repository's CI and release workflow use npm workspaces. Ignore
# incomplete alternate-package-manager metadata created by local tooling.
pnpm-lock.yaml
pnpm-workspace.yaml
.kodax/
.dsh/
.agent/
.repointel/
.claude/
.electron-smoke/

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Environment
.env
.env.local
.env.*.local

# Temp
.tmp/

# SA refactor goldens — recordings contain user prompts, file paths, and
# model responses captured from real KodaX sessions. Treat as PII-adjacent;
# regenerate locally with `tsx tests/sa-refactor-goldens/record-goldens.ts`.
tests/sa-refactor-goldens/recordings/

# Benchmark prompt-eval runs (FEATURE_104 v2). Run outputs are local-only,
# never committed under any circumstance — including "baseline" snapshots.
# The placeholder benchmark/results/.gitignore is the only tracked file
# under benchmark/results/.
benchmark/results/*
!benchmark/results/.gitignore
